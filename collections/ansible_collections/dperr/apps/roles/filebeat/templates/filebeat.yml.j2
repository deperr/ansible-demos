filebeat.inputs:
  - type: filestream
    id: syslogs
    enabled: true
    paths:
      - /var/log/messages
      - /var/log/secure
      - /var/log/audit/audit.log

output.kafka:
  hosts: ["{{ kafka_bind_ip }}:9092"]
  topic: '{{ kafka_topic }}'
  partition.round_robin:
    reachable_only: false
  required_acks: 1
  compression: gzip
  max_message_bytes: 1000000
